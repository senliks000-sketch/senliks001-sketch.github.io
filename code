<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Duolingo Mini App</title>
    <!-- Подключаем Telegram Web App скрипт -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #131f24;
            color: #ffffff;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .container {
            width: 100%;
            max-width: 400px;
            text-align: center;
        }
        .card {
            background-color: #1f2f38;
            border: 2px solid #2d424c;
            border-radius: 16px;
            padding: 20px;
            margin-top: 20px;
            box-shadow: 0 8px 0 #111a21;
        }
        h2 { color: #58cc02; }
        .btn {
            background-color: #58cc02;
            color: white;
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            margin-top: 15px;
            box-shadow: 0 4px 0 #46a302;
            transition: 0.1s;
        }
        .btn:active {
            transform: translateY(4px);
            box-shadow: none;
        }
        .option-btn {
            background-color: #2d424c;
            color: white;
            border: 2px solid #3c5966;
            border-radius: 12px;
            padding: 10px;
            margin: 8px 0;
            width: 100%;
            font-size: 15px;
            cursor: pointer;
        }
        .option-btn:hover { background-color: #3c5966; }
    </style>
</head>
<body>

    <div class="container" id="app">
        <h2>🦉 Английский с Duolingo</h2>
        <p id="user-greeting">Загрузка профиля...</p>
        
        <div class="card" id="lesson-card">
            <h3>Урок 1: Базовые слова</h3>
            <p id="question-text">Как переводится слово "Cat"?</p>
            
            <div id="options-container">
                <button class="option-btn" onclick="checkAnswer('Собака')">Собака</button>
                <button class="option-btn" onclick="checkAnswer('Кошка')">Кошка</button>
                <button class="option-btn" onclick="checkAnswer('Птица')">Птица</button>
            </div>
        </div>
        
        <button class="btn" onclick="startLesson()">Пройти урок заново</button>
    </div>

    <script>
        // Инициализация Telegram Web App
        let tg = window.Telegram.WebApp;
        tg.expand(); // Разворачиваем на весь экран

        let user = tg.initDataUnsafe.user;
        if (user) {
            document.getElementById('user-greeting').innerText = `Привет, ${user.first_name}! Твой мини-апп запущен.`;
        } else {
            document.getElementById('user-greeting').innerText = `Привет, Гость!`;
        }

        function checkAnswer(selected) {
            if (selected === 'Кошка') {
                alert('✅ Верно! Отличная работа.');
            } else {
                alert('❌ Неверно. Правильный ответ: Кошка');
            }
        }

        function startLesson() {
            alert('🎯 Урок перезапущен!');
        }
    </script>
</body>
</html>